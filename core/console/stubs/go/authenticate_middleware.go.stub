package middleware

import (
	"github.com/zatrano/framework/core/apitoken"
	"github.com/zatrano/framework/core/auth"
	. "github.com/zatrano/framework/core/http"
	. "github.com/zatrano/framework/core/routing"
)

// Authenticate ensures a bearer token is present (legacy placeholder).
// Prefer apitoken.Manager.Middleware for personal access tokens.
func Authenticate(next HandlerFunc) HandlerFunc {
	return func(req *Request) *Response {
		token := req.BearerToken()
		if token == "" {
			return JSON(map[string]any{
				"message": "Unauthenticated.",
			}).Status(401)
		}
		req.Set("api_token", token)
		return next(req)
	}
}

// AuthenticateToken authenticates via personal access tokens.
func AuthenticateToken(manager *apitoken.Manager, abilities ...string) MiddlewareFunc {
	return manager.Middleware(abilities...)
}

// AuthenticateSession ensures a session-authenticated user is present.
func AuthenticateSession(manager *auth.Manager) MiddlewareFunc {
	return auth.Middleware(manager)
}
